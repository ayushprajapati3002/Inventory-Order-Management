# For local containerized development (Docker Compose will use these for the 'db' container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory_db

# For running backend locally outside Docker (connecting to Docker's Postgres on localhost)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_db

# For connecting to Supabase (uncomment to override)
# DATABASE_URL=postgresql://postgres.<project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Frontend API URL (points to backend)
VITE_API_URL=http://localhost:8000
